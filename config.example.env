# Van https://developer.spotify.com/dashboard (je eigen app)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Moet exact zo in je Spotify-app staan onder "Redirect URIs"
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Weerplaats, klok en nachtmodus kun je ook op het scherm instellen (tandwiel).
# Wat je daar kiest, komt in instellingen.json en wint van de waarden hieronder.

# Rustscherm als niemand het scherm aanraakt: hoes (albumhoes groot, klok als er niks speelt) of klok
RUST_SCHERM=hoes

# Minuten zonder aanraking voordat het rustscherm verschijnt (ook als er muziek speelt)
SPOTISCHERM_IDLE_MIN=5

# Weer bij de klok (Open-Meteo, gratis). Leeg laten = geen weer.
WEER_PLAATS=
WEER_LAND=NL

# Nachtmodus: in deze periode wordt het scherm zwart als je het 30 s niet aanraakt.
# Beide leeg laten = nachtmodus uit.
NACHT_VAN=23:00
NACHT_TOT=07:00
# Hoe de nacht eruitziet: zwart, rood (rode klok) of grijs (donkergrijze klok).
# Het uur ervoor dimt het scherm geleidelijk, na afloop wordt het in 30 min weer normaal.
NACHT_STIJL=rood

# Indeling: auto (vierkant scherm = rond), rond of rechthoek
SCHERM_VORM=auto

# 1 = in een venster van 800x480 draaien, handig om op je pc te testen
SPOTISCHERM_WINDOWED=0
# 1 = muiscursor tonen als de app schermvullend draait (bijv. op je pc of met een muis aan de Pi)
SPOTISCHERM_MUIS=0
# 1 = rechtsboven tonen hoeveel beelden per seconde de app haalt (handig om te meten op de Pi)
SPOTISCHERM_TOON_FPS=0
# Instellingen via je telefoon: webpagina op http://spotischerm.local:8080 (zelfde wifi).
# 0 = uit. Alleen de scherminstellingen, nooit je Spotify-sleutels.
SPOTISCHERM_WEB_POORT=8080
# 1 = zuinige stand voor trage Pi's (Pi 1, Zero, 2B): kleinere hoes, 10 fps, geen schuivende titels
SPOTISCHERM_ZUINIG=0
# 1 = zelf naar /dev/fb0 tekenen i.p.v. via SDL/KMS; voor Pi's waar het scherm anders zwart
#     blijft (zoals de Pi 1). Touch en muis worden dan ook door de app zelf gelezen.
SPOTISCHERM_FRAMEBUFFER=0

# Taal: nl, en, de, fr of es. Lettertype: standaard, roboto, opensans, lato, comic, serif of mono.
# Beide kun je ook op het scherm kiezen (Instellingen).
TAAL=nl
LETTERTYPE=standaard
# Accentkleur: groen, blauw, oranje, roze, paars of hoes (kleur van de albumhoes).
KLEUR=groen
# Scherm draaien in graden met de klok mee: 0 (liggend), 90 of 270 (staand), 180 (ondersteboven).
DRAAIEN=0

# Gast-wifi voor de Delen-pagina: gasten scannen de QR-code en zitten meteen op je wifi.
# Leeg laten = geen wifi-QR-code. Gebruik bij voorkeur een apart gastennetwerk: het
# wachtwoord staat leesbaar op het scherm. Beveiliging: WPA (ook voor WPA2/WPA3), WEP of geen.
GAST_WIFI_NAAM=
GAST_WIFI_WACHTWOORD=
GAST_WIFI_BEVEILIGING=WPA
